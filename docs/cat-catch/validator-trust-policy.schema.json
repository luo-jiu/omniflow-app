{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/validator-trust-policy.schema.json",
  "title": "Cat Catch validator trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyVersion",
    "trustMode",
    "hashProfile",
    "approvalProviders",
    "trustedValidatorBundles",
    "trustedRunnerIdentities",
    "protectedPaths",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "./validator-trust-policy.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "trustMode": {
      "enum": ["blocked", "active"]
    },
    "hashProfile": {
      "const": "sha256-raw-source-manifest-v1"
    },
    "approvalProviders": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/approvalProvider"
      }
    },
    "trustedValidatorBundles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trustedValidatorBundle"
      }
    },
    "trustedRunnerIdentities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trustedRunnerIdentity"
      }
    },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)"
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "trustMode": { "const": "active" } },
        "required": ["trustMode"]
      },
      "then": {
        "properties": {
          "approvalProviders": { "type": "array", "minItems": 1 },
          "trustedValidatorBundles": { "type": "array", "minItems": 1 },
          "trustedRunnerIdentities": { "type": "array", "minItems": 1 },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "trustMode": { "const": "blocked" } },
        "required": ["trustMode"]
      },
      "then": {
        "properties": {
          "blockers": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approvalProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "allowedLocatorPrefixes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["user-decision", "pull-request-review", "signed-commit"] },
        "allowedLocatorPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trustedValidatorBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validatorId", "version", "sourceManifestHash", "approvalRef"],
      "properties": {
        "validatorId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "sourceManifestHash": { "$ref": "#/$defs/sha256" },
        "approvalRef": { "$ref": "decision-record.schema.json#/$defs/approvalRef" }
      }
    },
    "trustedRunnerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerId", "identityKind", "identityLocator", "approvalRef"],
      "properties": {
        "runnerId": { "$ref": "#/$defs/identifier" },
        "identityKind": { "enum": ["local-signed-runner", "ci-workflow", "release-runner"] },
        "identityLocator": { "type": "string", "minLength": 1 },
        "approvalRef": { "$ref": "decision-record.schema.json#/$defs/approvalRef" }
      }
    },
    "validatorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validatorId",
        "version",
        "sourceManifestHash",
        "trustPolicyHash",
        "trustClassification",
        "approvalRef"
      ],
      "properties": {
        "validatorId": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "sourceManifestHash": { "$ref": "#/$defs/sha256" },
        "trustPolicyHash": { "$ref": "#/$defs/sha256" },
        "trustClassification": { "enum": ["candidate-untrusted", "trusted"] },
        "approvalRef": {
          "oneOf": [
            { "$ref": "decision-record.schema.json#/$defs/approvalRef" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "trustClassification": { "const": "trusted" } },
            "required": ["trustClassification"]
          },
          "then": {
            "properties": {
              "approvalRef": { "$ref": "decision-record.schema.json#/$defs/approvalRef" }
            }
          }
        },
        {
          "if": {
            "properties": { "trustClassification": { "const": "candidate-untrusted" } },
            "required": ["trustClassification"]
          },
          "then": {
            "properties": { "approvalRef": { "type": "null" } }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "resolutionCriteria", "blocksGates"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1 },
        "resolutionCriteria": { "type": "string", "minLength": 1 },
        "blocksGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"] }
        }
      }
    }
  }
}
