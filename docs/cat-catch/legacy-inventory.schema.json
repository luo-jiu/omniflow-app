{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/legacy-inventory.schema.json",
  "title": "Cat Catch declarative local legacy inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "inventoryVersion",
    "discoveryRulesVersion",
    "bootstrapRoots",
    "semanticScanRules",
    "historicalTouchsets",
    "historicalCandidates",
    "declaredDynamicEdges",
    "entries",
    "approvedExclusions"
  ],
  "properties": {
    "$schema": { "const": "./legacy-inventory.schema.json" },
    "schemaVersion": { "const": 1 },
    "inventoryVersion": { "$ref": "#/$defs/version" },
    "discoveryRulesVersion": { "$ref": "#/$defs/version" },
    "bootstrapRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bootstrapRoot" }
    },
    "semanticScanRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semanticScanRule" }
    },
    "historicalTouchsets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/historicalTouchset" }
    },
    "historicalCandidates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/historicalCandidate" }
    },
    "declaredDynamicEdges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dynamicEdge" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/currentNode" },
          { "$ref": "#/$defs/retiredTombstone" }
        ]
      }
    },
    "approvedExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/approvedExclusion" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:.*/)?\\.{1,2}(?:/|$))(?!.*[\\\\\\u0000-\\u001F\\u007F])[^/]+(?:/[^/]+)*$"
    },
    "nullableIdentifier": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "nullableSymbol": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "locatorKind": {
      "enum": ["declaration", "member", "runtime-literal"]
    },
    "nodeLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol"],
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" }
      }
    },
    "bootstrapRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "path", "symbol", "traversal"],
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "category": {
          "enum": [
            "composition-root",
            "service-construction",
            "session-view-lifecycle",
            "ipc-registration",
            "preload-surface",
            "shared-contract",
            "renderer-workflow",
            "runtime-builder",
            "state-owner",
            "task-output-owner",
            "config-switch"
          ]
        },
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" },
        "traversal": { "enum": ["forward", "reverse", "both"] }
      }
    },
    "semanticScanRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pathScopes", "patterns", "excludedPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "pathScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "historicalTouchset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromCommit", "throughCommit", "pathScopes", "searchTerms"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "fromCommit": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "throughCommit": { "$ref": "#/$defs/commit" },
        "pathScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "searchTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "historicalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "symbol", "lastKnownCommit", "sourceHash", "resolution"],
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" },
        "lastKnownCommit": { "$ref": "#/$defs/commit" },
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "resolution": {
          "oneOf": [
            { "$ref": "#/$defs/candidateResolution" },
            { "type": "null" }
          ]
        }
      }
    },
    "candidateResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "refId"],
      "properties": {
        "kind": { "enum": ["current-node", "approved-exclusion", "retired-tombstone"] },
        "refId": { "$ref": "#/$defs/identifier" }
      }
    },
    "dynamicEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "target", "sourceHash", "resolutionRule", "fixtureId"],
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": { "const": "process-handoff" }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^external-process/[a-z0-9][a-z0-9._-]*$"
                  },
                  "symbol": { "type": "null" }
                }
              }
            }
          },
          "else": {
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!external-process/)"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": [
            "dynamic-import",
            "dynamic-require",
            "path-load",
            "ipc-channel",
            "preload-channel",
            "event-dispatch",
            "runtime-template",
            "worker-script",
            "serialized-envelope",
            "process-handoff",
            "file-handoff"
          ]
        },
        "source": { "$ref": "#/$defs/nodeLocator" },
        "target": { "$ref": "#/$defs/nodeLocator" },
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "resolutionRule": { "type": "string", "minLength": 1 },
        "fixtureId": { "$ref": "#/$defs/identifier" }
      }
    },
    "currentNode": {
      "type": "object",
      "additionalProperties": false,
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "required": [
        "id",
        "entryType",
        "path",
        "symbol",
        "sourceHash",
        "classification",
        "ownerRole",
        "capabilityId",
        "cutoverUnitId",
        "provenanceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "entryType": { "const": "current-node" },
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" },
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "classification": { "enum": ["legacy", "candidate", "target", "omniflow-integration"] },
        "ownerRole": {
          "enum": [
            "production-owner",
            "candidate-owner",
            "inactive-owner",
            "adapter",
            "contract",
            "state-owner",
            "task-owner",
            "output-owner",
            "helper",
            "test-helper"
          ]
        },
        "capabilityId": { "$ref": "#/$defs/nullableIdentifier" },
        "cutoverUnitId": { "$ref": "#/$defs/nullableIdentifier" },
        "provenanceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retiredTombstone": {
      "type": "object",
      "additionalProperties": false,
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "required": [
        "id",
        "entryType",
        "path",
        "symbol",
        "deletedSourceHash",
        "capabilityId",
        "cutoverUnitId",
        "deletionCommit",
        "deletionEvidenceRef",
        "provenanceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "entryType": { "const": "retired-tombstone" },
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" },
        "deletedSourceHash": { "$ref": "#/$defs/sha256" },
        "capabilityId": { "$ref": "#/$defs/identifier" },
        "cutoverUnitId": { "$ref": "#/$defs/identifier" },
        "deletionCommit": { "$ref": "#/$defs/commit" },
        "deletionEvidenceRef": { "$ref": "report-index-entry.schema.json#/$defs/artifactReference" },
        "provenanceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvedExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidateKind", "path", "symbol", "decision"],
      "dependentSchemas": {
        "locatorKind": { "properties": { "symbol": { "type": "string" } } }
      },
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "candidateKind": { "enum": ["current", "historical"] },
        "path": { "$ref": "#/$defs/path" },
        "symbol": { "$ref": "#/$defs/nullableSymbol" },
        "locatorKind": { "$ref": "#/$defs/locatorKind" },
        "decision": { "$ref": "decision-record.schema.json" }
      }
    }
  }
}
