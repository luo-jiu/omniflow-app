{
  "$schema": "./evidence-retention-policy.schema.json",
  "schemaVersion": 1,
  "policyVersion": "2026-08-23.1",
  "promotionMode": "disabled",
  "availabilityMaxAgeSeconds": 604800,
  "allowedOfficialStorageTypes": [
    "github-release-asset",
    "evidence-store",
    "object-storage"
  ],
  "allowedOfficialUriSchemes": ["https"],
  "candidateStores": [
    {
      "id": "local-candidate-artifacts",
      "storageType": "local-untracked",
      "allowedUriPrefixes": ["workspace-artifact://cat-catch-lab/artifacts/"],
      "maxArtifactBytes": 1073741824
    }
  ],
  "officialStores": [],
  "releaseLifecycle": {
    "supportStateSource": "immutable-release-ref-metadata",
    "maintenanceEndField": "maintenanceEndsAt",
    "rollbackWindowEndField": "rollbackWindowEndsAt",
    "requireMaintenanceAndRollbackEndBeforeDeletion": true
  },
  "deletionConditions": [
    "all-gates-replaced-by-equivalent-evidence",
    "all-supported-releases-ended-maintenance",
    "all-dependent-releases-ended-rollback-window",
    "auditable-deletion-record-written"
  ],
  "blockers": [
    {
      "id": "retention.official-store-unresolved",
      "reason": "No durable canonical evidence store and exact HTTPS URI prefix have been approved.",
      "resolutionCriteria": "Configure at least one approved durable store whose lifecycle covers supported releases and rollback windows, then enable official promotion.",
      "blocksGates": ["G0", "G5", "G7"]
    }
  ]
}
