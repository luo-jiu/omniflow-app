{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/evidence-retention-policy.schema.json",
  "title": "Cat Catch evidence retention policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policyVersion",
    "promotionMode",
    "availabilityMaxAgeSeconds",
    "allowedOfficialStorageTypes",
    "allowedOfficialUriSchemes",
    "candidateStores",
    "officialStores",
    "releaseLifecycle",
    "deletionConditions",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "./evidence-retention-policy.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "promotionMode": {
      "enum": ["disabled", "enabled"]
    },
    "availabilityMaxAgeSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "allowedOfficialStorageTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["github-release-asset", "evidence-store", "object-storage"]
      }
    },
    "allowedOfficialUriSchemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "https"
      }
    },
    "candidateStores": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidateStore"
      }
    },
    "officialStores": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/officialStore"
      }
    },
    "releaseLifecycle": {
      "$ref": "#/$defs/releaseLifecycle"
    },
    "deletionConditions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "all-gates-replaced-by-equivalent-evidence",
          "all-supported-releases-ended-maintenance",
          "all-dependent-releases-ended-rollback-window",
          "auditable-deletion-record-written"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "promotionMode": {
            "const": "enabled"
          }
        },
        "required": ["promotionMode"]
      },
      "then": {
        "properties": {
          "officialStores": { "type": "array", "minItems": 1 },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "promotionMode": {
            "const": "disabled"
          }
        },
        "required": ["promotionMode"]
      },
      "then": {
        "properties": {
          "blockers": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "candidateStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "storageType", "allowedUriPrefixes", "maxArtifactBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "storageType": { "const": "local-untracked" },
        "allowedUriPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxArtifactBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "officialStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "storageType", "allowedUriPrefixes", "allowRedirects", "maxArtifactBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "storageType": {
          "enum": ["github-release-asset", "evidence-store", "object-storage"]
        },
        "allowedUriPrefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "allowRedirects": { "const": false },
        "maxArtifactBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "releaseLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportStateSource",
        "maintenanceEndField",
        "rollbackWindowEndField",
        "requireMaintenanceAndRollbackEndBeforeDeletion"
      ],
      "properties": {
        "supportStateSource": { "const": "immutable-release-ref-metadata" },
        "maintenanceEndField": { "const": "maintenanceEndsAt" },
        "rollbackWindowEndField": { "const": "rollbackWindowEndsAt" },
        "requireMaintenanceAndRollbackEndBeforeDeletion": { "const": true }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "resolutionCriteria", "blocksGates"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1 },
        "resolutionCriteria": { "type": "string", "minLength": 1 },
        "blocksGates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["G0", "G5", "G7"] }
        }
      }
    }
  }
}
