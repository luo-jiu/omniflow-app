{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/evidence-artifact.schema.json",
  "title": "Cat Catch evidence artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "artifactId",
    "artifactType",
    "evidenceRole",
    "evidenceDimension",
    "deploymentUnderTest",
    "capabilityIds",
    "releaseTargetId",
    "evidenceInputCommit",
    "evidenceInputTreeHash",
    "upstreamSnapshot",
    "environmentFingerprint",
    "producer",
    "inputHash",
    "commandResults",
    "status",
    "startedAt",
    "finishedAt",
    "attachments"
  ],
  "properties": {
    "$schema": {
      "const": "https://omniflow.local/schemas/cat-catch/evidence-artifact.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "artifactId": { "$ref": "#/$defs/identifier" },
    "artifactType": {
      "enum": ["unit", "differential", "integration", "output", "soak", "package-smoke", "transition"]
    },
    "evidenceRole": { "enum": ["current-invariant", "transition-history"] },
    "evidenceDimension": {
      "enum": [
        "mapping",
        "fixture",
        "behavior",
        "candidateIntegration",
        "candidateSoak",
        "activeIntegration",
        "activeSoak",
        "transition"
      ]
    },
    "deploymentUnderTest": {
      "enum": ["oracle", "legacy-owner", "candidate", "new-owner", "not-applicable"]
    },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "releaseTargetId": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "evidenceInputCommit": { "$ref": "#/$defs/commit" },
    "evidenceInputTreeHash": { "$ref": "#/$defs/sha256" },
    "upstreamSnapshot": { "$ref": "#/$defs/upstreamSnapshot" },
    "environmentFingerprint": { "$ref": "#/$defs/environmentFingerprint" },
    "producer": { "$ref": "#/$defs/producer" },
    "inputHash": { "$ref": "#/$defs/sha256" },
    "commandResults": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/commandResult" }
    },
    "status": { "enum": ["passed", "failed"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "attachments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/attachment" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evidenceRole": { "const": "transition-history" } },
        "required": ["evidenceRole"]
      },
      "then": {
        "properties": { "evidenceDimension": { "const": "transition" } }
      }
    },
    {
      "if": {
        "properties": { "evidenceRole": { "const": "current-invariant" } },
        "required": ["evidenceRole"]
      },
      "then": {
        "properties": {
          "evidenceDimension": {
            "not": { "const": "transition" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceDimension": {
            "enum": ["candidateIntegration", "candidateSoak"]
          }
        },
        "required": ["evidenceDimension"]
      },
      "then": {
        "properties": { "deploymentUnderTest": { "const": "candidate" } }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceDimension": {
            "enum": ["activeIntegration", "activeSoak"]
          }
        },
        "required": ["evidenceDimension"]
      },
      "then": {
        "properties": { "deploymentUnderTest": { "const": "new-owner" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "commandResults": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "exitCode": { "const": 0 },
                "status": { "const": "passed" }
              },
              "required": ["exitCode", "status"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "upstreamSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifestHash"],
      "properties": {
        "commit": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "manifestHash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "commit": { "$ref": "#/$defs/commit" },
            "manifestHash": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "properties": {
            "commit": { "type": "null" },
            "manifestHash": { "type": "null" }
          }
        }
      ]
    },
    "environmentFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "electron", "chromium", "node", "ffmpeg"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "enum": ["arm64", "x64"] },
        "electron": { "type": "string", "minLength": 1 },
        "chromium": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "ffmpeg": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerId",
        "runnerClassification",
        "toolId",
        "toolVersion",
        "toolSourceManifestHash",
        "trustPolicyHash",
        "attestationRef"
      ],
      "properties": {
        "runnerId": { "$ref": "#/$defs/identifier" },
        "runnerClassification": { "enum": ["candidate-local", "trusted-runner"] },
        "toolId": { "$ref": "#/$defs/identifier" },
        "toolVersion": { "type": "string", "minLength": 1 },
        "toolSourceManifestHash": { "$ref": "#/$defs/sha256" },
        "trustPolicyHash": { "$ref": "#/$defs/sha256" },
        "attestationRef": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "runnerClassification": { "const": "candidate-local" } },
            "required": ["runnerClassification"]
          },
          "then": { "properties": { "attestationRef": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "runnerClassification": { "const": "trusted-runner" } },
            "required": ["runnerClassification"]
          },
          "then": { "properties": { "attestationRef": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "commandFingerprint",
        "exitCode",
        "status",
        "startedAt",
        "finishedAt",
        "stdoutHash",
        "stderrHash"
      ],
      "properties": {
        "checkId": { "$ref": "#/$defs/identifier" },
        "commandFingerprint": { "$ref": "#/$defs/sha256" },
        "exitCode": { "type": "integer" },
        "status": { "enum": ["passed", "failed"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "stdoutHash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "stderrHash": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mediaType", "contentHash", "byteLength", "locations"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "mediaType": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "locations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
