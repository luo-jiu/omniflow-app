{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/report-index-entry.schema.json",
  "title": "Cat Catch report index entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactKind",
    "artifactSchemaId",
    "contentHash",
    "byteLength",
    "evidenceInputCommit",
    "evidenceInputTreeHash",
    "locations",
    "validationSummary",
    "indexedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactId": { "$ref": "#/$defs/identifier" },
    "artifactKind": {
      "enum": [
        "evidence",
        "capability-state",
        "local-closure",
        "artifact-availability",
        "gate",
        "seal",
        "decision"
      ]
    },
    "artifactSchemaId": { "type": "string", "format": "uri" },
    "contentHash": { "$ref": "#/$defs/sha256" },
    "byteLength": { "type": "integer", "minimum": 1 },
    "evidenceInputCommit": { "$ref": "#/$defs/commit" },
    "evidenceInputTreeHash": { "$ref": "#/$defs/sha256" },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": ["canonical"],
        "properties": { "canonical": { "const": true } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/storageLocation" }
    },
    "validationSummary": { "$ref": "#/$defs/validationSummary" },
    "indexedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactSchemaId", "contentHash"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "artifactSchemaId": { "type": "string", "format": "uri" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "storageLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "uri", "canonical"],
      "properties": {
        "storeId": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "canonical": { "type": "boolean" }
      }
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValidated",
        "hashValidated",
        "reportedStatus",
        "validatedAt",
        "validatorSourceManifestHash"
      ],
      "properties": {
        "schemaValidated": { "type": "boolean" },
        "hashValidated": { "type": "boolean" },
        "reportedStatus": { "enum": ["pending", "in-progress", "passed", "failed", "blocked", "stale"] },
        "validatedAt": { "type": "string", "format": "date-time" },
        "validatorSourceManifestHash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
