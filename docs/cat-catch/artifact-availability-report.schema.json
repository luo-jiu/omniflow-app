{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/artifact-availability-report.schema.json",
  "title": "Cat Catch artifact availability report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "validator",
    "evidenceInputCommit",
    "evidenceInputTreeHash",
    "retentionPolicyHash",
    "projectionHashProfile",
    "coveredIndexProjectionHash",
    "checkedAt",
    "nextCheckDueAt",
    "supportedReleases",
    "artifactChecks",
    "staleArtifactIds",
    "status",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "https://omniflow.local/schemas/cat-catch/artifact-availability-report.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "reportId": { "$ref": "#/$defs/identifier" },
    "validator": { "$ref": "validator-trust-policy.schema.json#/$defs/validatorBinding" },
    "evidenceInputCommit": { "$ref": "#/$defs/commit" },
    "evidenceInputTreeHash": { "$ref": "#/$defs/sha256" },
    "retentionPolicyHash": { "$ref": "#/$defs/sha256" },
    "projectionHashProfile": { "const": "report-index-covered-projection-jcs-v1" },
    "coveredIndexProjectionHash": { "$ref": "#/$defs/sha256" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "nextCheckDueAt": { "type": "string", "format": "date-time" },
    "supportedReleases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/supportedRelease" }
    },
    "artifactChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactCheck" }
    },
    "staleArtifactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "status": { "enum": ["passed", "blocked", "stale"] },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/blocker" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validator": {
            "type": "object",
            "properties": { "trustClassification": { "const": "trusted" } }
          },
          "artifactChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": { "result": { "const": "current" } }
            }
          },
          "supportedReleases": { "type": "array", "minItems": 1 },
          "staleArtifactIds": { "type": "array", "maxItems": 0 },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supportedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseRef", "releaseState", "maintenanceEndsAt", "rollbackWindowEndsAt"],
      "properties": {
        "releaseRef": { "type": "string", "minLength": 1 },
        "releaseState": { "enum": ["supported", "ended"] },
        "maintenanceEndsAt": { "type": "string", "format": "date-time" },
        "rollbackWindowEndsAt": { "type": "string", "format": "date-time" }
      }
    },
    "storageCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeId", "uri", "readable", "schemaValid", "hashMatches", "retentionCovered", "expiresAt", "message"],
      "properties": {
        "storeId": { "$ref": "#/$defs/identifier" },
        "uri": { "type": "string", "minLength": 1 },
        "readable": { "type": "boolean" },
        "schemaValid": { "type": "boolean" },
        "hashMatches": { "type": "boolean" },
        "retentionCovered": { "type": "boolean" },
        "expiresAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "message": { "type": "string" }
      }
    },
    "artifactCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "expectedHash", "artifactSchemaId", "storageChecks", "result"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/identifier" },
        "expectedHash": { "$ref": "#/$defs/sha256" },
        "artifactSchemaId": { "type": "string", "format": "uri" },
        "storageChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/storageCheck" }
        },
        "result": { "enum": ["current", "stale"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "current" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "storageChecks": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "readable": { "const": true },
                    "schemaValid": { "const": true },
                    "hashMatches": { "const": true },
                    "retentionCovered": { "const": true }
                  },
                  "required": ["readable", "schemaValid", "hashMatches", "retentionCovered"]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "artifactId", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "artifactId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
