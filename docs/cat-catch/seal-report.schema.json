{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/seal-report.schema.json",
  "title": "Cat Catch external final seal report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "terminalGate",
    "validator",
    "generatedAt",
    "evidenceInputCommit",
    "evidenceInputTreeHash",
    "sealCommit",
    "schemaBundleHash",
    "retentionPolicyHash",
    "validatorTrustPolicyHash",
    "reportIndexHash",
    "gateReports",
    "preSealEvidenceRefs",
    "sealDiff",
    "releaseRef",
    "status",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "https://omniflow.local/schemas/cat-catch/seal-report.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "reportId": { "$ref": "#/$defs/identifier" },
    "terminalGate": { "const": "G7" },
    "validator": { "$ref": "validator-trust-policy.schema.json#/$defs/validatorBinding" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceInputCommit": { "$ref": "#/$defs/commit" },
    "evidenceInputTreeHash": { "$ref": "#/$defs/sha256" },
    "sealCommit": { "$ref": "#/$defs/commit" },
    "schemaBundleHash": { "$ref": "#/$defs/sha256" },
    "retentionPolicyHash": { "$ref": "#/$defs/sha256" },
    "validatorTrustPolicyHash": { "$ref": "#/$defs/sha256" },
    "reportIndexHash": { "$ref": "#/$defs/sha256" },
    "gateReports": { "$ref": "#/$defs/gateReports" },
    "preSealEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "sealDiff": { "$ref": "#/$defs/sealDiff" },
    "releaseRef": { "$ref": "#/$defs/releaseRef" },
    "status": { "enum": ["passed", "failed", "blocked"] },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/blocker" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validator": {
            "type": "object",
            "properties": { "trustClassification": { "const": "trusted" } }
          },
          "sealDiff": {
            "type": "object",
            "properties": {
              "reportIndexOnlyChangesValidated": { "const": true },
              "generatedProgressBlockMatchesDerivedReports": { "const": true },
              "disallowedChanges": { "type": "array", "maxItems": 0 }
            }
          },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactRef": {
      "$ref": "report-index-entry.schema.json#/$defs/artifactReference"
    },
    "gateReports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7-pre-seal"],
      "properties": {
        "G0": { "$ref": "#/$defs/artifactRef" },
        "G1": { "$ref": "#/$defs/artifactRef" },
        "G2": { "$ref": "#/$defs/artifactRef" },
        "G3": { "$ref": "#/$defs/artifactRef" },
        "G4": { "$ref": "#/$defs/artifactRef" },
        "G5": { "$ref": "#/$defs/artifactRef" },
        "G6": { "$ref": "#/$defs/artifactRef" },
        "G7-pre-seal": { "$ref": "#/$defs/artifactRef" }
      }
    },
    "sealDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedDiffProfile",
        "changedPaths",
        "reportIndexPaths",
        "generatedProgressBlockChanged",
        "reportIndexOnlyChangesValidated",
        "generatedProgressBlockMatchesDerivedReports",
        "disallowedChanges"
      ],
      "properties": {
        "allowedDiffProfile": { "const": "report-index-and-generated-progress-v1" },
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)" }
        },
        "reportIndexPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^docs/cat-catch/report-index/" }
        },
        "generatedProgressBlockChanged": { "type": "boolean" },
        "reportIndexOnlyChangesValidated": { "type": "boolean" },
        "generatedProgressBlockMatchesDerivedReports": { "type": "boolean" },
        "disallowedChanges": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "releaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "targetCommit", "metadataBindingKey", "immutabilityMechanism"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "targetCommit": { "$ref": "#/$defs/commit" },
        "metadataBindingKey": { "const": "cat-catch-seal-report-sha256" },
        "immutabilityMechanism": { "enum": ["protected-tag", "signed-tag", "release-metadata-lock"] }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
