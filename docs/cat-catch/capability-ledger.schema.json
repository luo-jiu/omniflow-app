{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/capability-ledger.schema.json",
  "title": "Cat Catch declarative capability ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "ledgerVersion",
    "cutoverUnits",
    "exclusionFamilies",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "const": "./capability-ledger.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "ledgerVersion": {
      "$ref": "#/$defs/version"
    },
    "cutoverUnits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/cutoverUnit"
      }
    },
    "exclusionFamilies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusionFamily"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableCommit": {
      "oneOf": [
        { "$ref": "#/$defs/commit" },
        { "type": "null" }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)"
    },
    "evidenceDimension": {
      "enum": [
        "fixture",
        "behavior",
        "candidateIntegration",
        "candidateSoak",
        "activeIntegration",
        "activeSoak"
      ]
    },
    "cutoverUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "atomicCutover",
        "dependsOn",
        "dependencyMapping",
        "dispatchBoundaryRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "atomicCutover": { "const": true },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "dependencyMapping": { "enum": ["pending", "specified"] },
        "dispatchBoundaryRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "exclusionFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scopePatterns", "decision"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scopePatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": { "$ref": "decision-record.schema.json" }
      }
    },
    "upstreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor", "introducedBy", "blobHash"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "anchor": { "type": "string", "minLength": 1 },
        "introducedBy": { "$ref": "#/$defs/nullableCommit" },
        "blobHash": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "verifiedUpstreamSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor", "introducedBy", "blobHash"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "anchor": { "type": "string", "minLength": 1 },
        "introducedBy": { "$ref": "#/$defs/commit" },
        "blobHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "localContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor", "sourceHash"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "anchor": { "type": "string", "minLength": 1 },
        "sourceHash": { "$ref": "#/$defs/nullableSha256" }
      }
    },
    "verifiedLocalContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor", "sourceHash"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "anchor": { "type": "string", "minLength": 1 },
        "sourceHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "requiredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeCutover", "forCompletion"],
      "properties": {
        "beforeCutover": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceDimension" }
        },
        "forCompletion": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceDimension" }
        }
      }
    },
    "ownerRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetProduction", "candidate", "legacy"],
      "properties": {
        "targetProduction": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "candidate": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "legacy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "boundary",
        "cutoverUnitId",
        "additionalRiskTags",
        "upstreamSources",
        "localContractRefs",
        "auditedThrough",
        "oracleRelation",
        "disposition",
        "mapping",
        "requiredEvidence",
        "ownerRefs",
        "fixtures",
        "decision",
        "acceptedDifferences",
        "notes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "origin": { "enum": ["upstream-derived", "omniflow-integration", "cross-boundary"] },
        "boundary": { "$ref": "#/$defs/identifier" },
        "cutoverUnitId": { "$ref": "#/$defs/identifier" },
        "additionalRiskTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "upstreamSources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/upstreamSource" }
        },
        "localContractRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localContractRef" }
        },
        "auditedThrough": { "$ref": "#/$defs/nullableCommit" },
        "oracleRelation": {
          "enum": [
            "exact",
            "semantic-equivalent",
            "platform-substitute",
            "recorded-upstream",
            "spec-derived",
            "not-applicable",
            "excluded"
          ]
        },
        "disposition": {
          "enum": [
            "pending",
            "faithful-port",
            "adapted-equivalent",
            "upstream-defect-fix",
            "omniflow-native",
            "intentional-exclusion"
          ]
        },
        "mapping": { "enum": ["unmapped", "specified"] },
        "requiredEvidence": { "$ref": "#/$defs/requiredEvidence" },
        "ownerRefs": { "$ref": "#/$defs/ownerRefs" },
        "fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "decision": {
          "oneOf": [
            { "$ref": "decision-record.schema.json" },
            { "type": "null" }
          ]
        },
        "acceptedDifferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "decision-record.schema.json" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mapping": { "const": "unmapped" } },
            "required": ["mapping"]
          },
          "then": {
            "properties": { "disposition": { "const": "pending" } }
          }
        },
        {
          "if": {
            "properties": { "mapping": { "const": "specified" } },
            "required": ["mapping"]
          },
          "then": {
            "not": {
              "properties": { "disposition": { "const": "pending" } },
              "required": ["disposition"]
            },
            "properties": {
              "auditedThrough": { "$ref": "#/$defs/commit" },
              "upstreamSources": {
                "type": "array",
                "items": { "$ref": "#/$defs/verifiedUpstreamSource" }
              },
              "localContractRefs": {
                "type": "array",
                "items": { "$ref": "#/$defs/verifiedLocalContractRef" }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "origin": { "const": "upstream-derived" } },
            "required": ["origin"]
          },
          "then": {
            "properties": { "upstreamSources": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "origin": { "const": "omniflow-integration" } },
            "required": ["origin"]
          },
          "then": {
            "properties": {
              "upstreamSources": { "type": "array", "maxItems": 0 },
              "localContractRefs": { "type": "array", "minItems": 1 },
              "oracleRelation": { "const": "not-applicable" }
            }
          }
        },
        {
          "if": {
            "properties": { "origin": { "const": "cross-boundary" } },
            "required": ["origin"]
          },
          "then": {
            "properties": {
              "upstreamSources": { "type": "array", "minItems": 1 },
              "localContractRefs": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "intentional-exclusion" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "auditedThrough": { "$ref": "#/$defs/commit" },
              "oracleRelation": { "const": "excluded" },
              "decision": { "$ref": "decision-record.schema.json" },
              "ownerRefs": {
                "type": "object",
                "properties": {
                  "targetProduction": { "type": "array", "maxItems": 0 },
                  "candidate": { "type": "array", "maxItems": 0 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "upstream-defect-fix" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "acceptedDifferences": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "disposition": { "const": "intentional-exclusion" } },
              "required": ["disposition"]
            }
          },
          "then": {
            "properties": {
              "ownerRefs": {
                "type": "object",
                "properties": {
                  "targetProduction": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1
                  }
                }
              },
              "requiredEvidence": {
                "type": "object",
                "properties": {
                  "beforeCutover": {
                    "type": "array",
                    "allOf": [
                      { "contains": { "const": "fixture" } },
                      { "contains": { "const": "behavior" } }
                    ]
                  },
                  "forCompletion": {
                    "type": "array",
                    "allOf": [
                      { "contains": { "const": "fixture" } },
                      { "contains": { "const": "behavior" } }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
