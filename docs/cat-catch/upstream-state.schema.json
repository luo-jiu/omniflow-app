{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/upstream-state.schema.json",
  "title": "Cat Catch upstream state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repository",
    "baselineCursor",
    "observedHead",
    "auditedThrough",
    "verificationTarget",
    "releaseCursor"
  ],
  "properties": {
    "$schema": {
      "const": "./upstream-state.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "const": "https://github.com/xifangczy/cat-catch"
    },
    "baselineCursor": {
      "const": "2cb981d7c2f4614732edccc167c4b5793d1cb138"
    },
    "observedHead": {
      "$ref": "#/$defs/commit"
    },
    "auditedThrough": {
      "$ref": "#/$defs/nullableCommit"
    },
    "verificationTarget": {
      "$ref": "#/$defs/nullableCommit"
    },
    "releaseCursor": {
      "$ref": "#/$defs/nullableCommit"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nullableCommit": {
      "oneOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
