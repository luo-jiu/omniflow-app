{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/capability-state-report.schema.json",
  "title": "Cat Catch derived capability state report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "reportId",
    "validator",
    "generatedAt",
    "evidenceInputCommit",
    "evidenceInputTreeHash",
    "inputHashes",
    "upstreamSnapshot",
    "capabilities",
    "summary",
    "referencedArtifacts",
    "status",
    "blockers"
  ],
  "properties": {
    "$schema": {
      "const": "https://omniflow.local/schemas/cat-catch/capability-state-report.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "reportId": { "$ref": "#/$defs/identifier" },
    "validator": { "$ref": "validator-trust-policy.schema.json#/$defs/validatorBinding" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceInputCommit": { "$ref": "#/$defs/commit" },
    "evidenceInputTreeHash": { "$ref": "#/$defs/sha256" },
    "inputHashes": { "$ref": "#/$defs/inputHashes" },
    "upstreamSnapshot": { "$ref": "#/$defs/upstreamSnapshot" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityState" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "referencedArtifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "report-index-entry.schema.json#/$defs/artifactReference" }
    },
    "status": { "enum": ["pending", "in-progress", "passed", "blocked", "stale"] },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/blocker" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "validator": {
            "type": "object",
            "properties": { "trustClassification": { "const": "trusted" } }
          },
          "summary": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "minimum": 1 },
              "pending": { "const": 0 },
              "unmapped": { "const": 0 },
              "stale": { "const": 0 },
              "implementedUnverified": { "const": 0 }
            },
            "anyOf": [
              {
                "properties": { "included": { "type": "integer", "minimum": 1 } },
                "required": ["included"]
              },
              {
                "properties": { "intentionalExclusions": { "type": "integer", "minimum": 1 } },
                "required": ["intentionalExclusions"]
              }
            ]
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "freshness": { "const": "current" },
                "summaryState": {
                  "enum": ["excluded", "verified-candidate", "active-verified"]
                },
                "blockers": { "type": "array", "maxItems": 0 }
              },
              "required": ["freshness", "summaryState", "blockers"]
            }
          },
          "blockers": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaBundle",
        "upstreamState",
        "capabilityLedger",
        "legacyInventory",
        "releaseTargets",
        "riskPolicy",
        "automationPolicy",
        "evidenceRetentionPolicy",
        "validatorTrustPolicy"
      ],
      "properties": {
        "schemaBundle": { "$ref": "#/$defs/sha256" },
        "upstreamState": { "$ref": "#/$defs/sha256" },
        "capabilityLedger": { "$ref": "#/$defs/sha256" },
        "legacyInventory": { "$ref": "#/$defs/sha256" },
        "releaseTargets": { "$ref": "#/$defs/sha256" },
        "riskPolicy": { "$ref": "#/$defs/sha256" },
        "automationPolicy": { "$ref": "#/$defs/sha256" },
        "evidenceRetentionPolicy": { "$ref": "#/$defs/sha256" },
        "validatorTrustPolicy": { "$ref": "#/$defs/sha256" }
      }
    },
    "upstreamSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "manifestHash"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "manifestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping",
        "fixture",
        "behavior",
        "candidateIntegration",
        "candidateSoak",
        "activeIntegration",
        "activeSoak"
      ],
      "properties": {
        "mapping": { "enum": ["unmapped", "specified", "stale"] },
        "fixture": { "enum": ["missing", "ready", "not-required", "stale"] },
        "behavior": { "$ref": "#/$defs/evidenceResult" },
        "candidateIntegration": { "$ref": "#/$defs/evidenceResult" },
        "candidateSoak": { "$ref": "#/$defs/evidenceResult" },
        "activeIntegration": { "$ref": "#/$defs/evidenceResult" },
        "activeSoak": { "$ref": "#/$defs/evidenceResult" }
      }
    },
    "evidenceResult": {
      "enum": ["pending", "pass", "not-required", "stale"]
    },
    "effectiveRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeCutover", "forCompletion"],
      "properties": {
        "beforeCutover": { "$ref": "#/$defs/dimensionSet" },
        "forCompletion": { "$ref": "#/$defs/dimensionSet" }
      }
    },
    "dimensionSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixture",
          "behavior",
          "candidateIntegration",
          "candidateSoak",
          "activeIntegration",
          "activeSoak"
        ]
      }
    },
    "resolvedOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerRef", "ownerRole", "reachable", "sourceHash"],
      "properties": {
        "ownerRef": { "type": "string", "minLength": 1 },
        "ownerRole": { "enum": ["production", "candidate", "legacy"] },
        "reachable": { "type": "boolean" },
        "sourceHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "resolvedOwners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "candidate", "legacy"],
      "properties": {
        "production": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolvedOwner" }
        },
        "candidate": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolvedOwner" }
        },
        "legacy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resolvedOwner" }
        }
      }
    },
    "axisArtifactRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping",
        "fixture",
        "behavior",
        "candidateIntegration",
        "candidateSoak",
        "activeIntegration",
        "activeSoak"
      ],
      "properties": {
        "mapping": { "$ref": "#/$defs/artifactRefSet" },
        "fixture": { "$ref": "#/$defs/artifactRefSet" },
        "behavior": { "$ref": "#/$defs/artifactRefSet" },
        "candidateIntegration": { "$ref": "#/$defs/artifactRefSet" },
        "candidateSoak": { "$ref": "#/$defs/artifactRefSet" },
        "activeIntegration": { "$ref": "#/$defs/artifactRefSet" },
        "activeSoak": { "$ref": "#/$defs/artifactRefSet" }
      }
    },
    "artifactRefSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "report-index-entry.schema.json#/$defs/artifactReference" }
    },
    "capabilityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "effectiveRiskTags",
        "verifiedThrough",
        "evidence",
        "effectiveRequiredEvidence",
        "deployment",
        "freshness",
        "resolvedOwners",
        "artifactRefs",
        "summaryState",
        "blockers"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "origin": { "enum": ["upstream-derived", "omniflow-integration", "cross-boundary"] },
        "effectiveRiskTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "verifiedThrough": {
          "oneOf": [
            { "$ref": "#/$defs/commit" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidenceAxes" },
        "effectiveRequiredEvidence": { "$ref": "#/$defs/effectiveRequirements" },
        "deployment": {
          "enum": [
            "legacy-owner",
            "legacy-inactive",
            "candidate",
            "new-owner",
            "legacy-removed",
            "no-runtime-owner"
          ]
        },
        "freshness": { "enum": ["current", "stale"] },
        "resolvedOwners": { "$ref": "#/$defs/resolvedOwners" },
        "artifactRefs": { "$ref": "#/$defs/axisArtifactRefs" },
        "summaryState": {
          "enum": [
            "unmapped",
            "implemented-unverified",
            "excluded",
            "verified-candidate",
            "active-verified",
            "stale",
            "blocked"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/blocker" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "included",
        "intentionalExclusions",
        "pending",
        "unmapped",
        "stale",
        "implementedUnverified"
      ],
      "properties": {
        "total": { "$ref": "#/$defs/count" },
        "included": { "$ref": "#/$defs/count" },
        "intentionalExclusions": { "$ref": "#/$defs/count" },
        "pending": { "$ref": "#/$defs/count" },
        "unmapped": { "$ref": "#/$defs/count" },
        "stale": { "$ref": "#/$defs/count" },
        "implementedUnverified": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "capabilityId"],
      "properties": {
        "code": { "$ref": "#/$defs/identifier" },
        "message": { "type": "string", "minLength": 1 },
        "capabilityId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
