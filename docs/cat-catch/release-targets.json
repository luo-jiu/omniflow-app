{
  "$schema": "./release-targets.schema.json",
  "schemaVersion": 1,
  "policyVersion": "2026-08-23.1",
  "targets": [
    {
      "id": "macos-arm64",
      "platform": "macos",
      "architectures": ["arm64"],
      "packageFormats": ["dmg", "zip"],
      "scopeDecision": "included",
      "decisionRef": null,
      "signing": {
        "requirement": "required",
        "method": "local-self-signed-code-signing",
        "requiredChecks": ["package-hash", "codesign-verify"]
      },
      "requiredSmokes": [
        "package-install-or-unpack",
        "packaged-app-launch",
        "cat-catch-network",
        "cat-catch-deep-search",
        "cat-catch-mse",
        "cat-catch-manifest",
        "ffmpeg-start-cancel-cleanup",
        "temp-restart-cleanup"
      ],
      "sourceRefs": [
        {
          "path": "electron-builder.json5",
          "selector": "$.mac.target"
        },
        {
          "path": "tools/release-mac.mjs",
          "selector": "mac-arm64 packaged application and codesign verification"
        }
      ],
      "blockerIds": []
    },
    {
      "id": "windows-x64",
      "platform": "windows",
      "architectures": ["x64"],
      "packageFormats": ["nsis"],
      "scopeDecision": "included",
      "decisionRef": null,
      "signing": {
        "requirement": "not-required",
        "method": null,
        "requiredChecks": ["package-hash", "package-install-or-unpack"]
      },
      "requiredSmokes": [
        "package-install-or-unpack",
        "packaged-app-launch",
        "cat-catch-network",
        "cat-catch-deep-search",
        "cat-catch-mse",
        "cat-catch-manifest",
        "ffmpeg-start-cancel-cleanup",
        "temp-restart-cleanup"
      ],
      "sourceRefs": [
        {
          "path": "electron-builder.json5",
          "selector": "$.win.target"
        },
        {
          "path": "docs/current-deployment-topology.md",
          "selector": "Windows x64 NSIS package and unsigned personal deployment"
        }
      ],
      "blockerIds": []
    },
    {
      "id": "linux-appimage",
      "platform": "linux",
      "architectures": ["x64"],
      "packageFormats": ["appimage"],
      "scopeDecision": "undecided",
      "decisionRef": null,
      "signing": {
        "requirement": "undecided",
        "method": null,
        "requiredChecks": []
      },
      "requiredSmokes": [],
      "sourceRefs": [
        {
          "path": "electron-builder.json5",
          "selector": "$.linux.target"
        }
      ],
      "blockerIds": ["release.linux-scope-undecided"]
    }
  ],
  "blockers": [
    {
      "id": "release.linux-scope-undecided",
      "targetId": "linux-appimage",
      "reason": "electron-builder configures AppImage, but product support and release validation policy are not decided.",
      "resolutionCriteria": "Record an approved include or exclude decision; included targets must define architectures, signing policy, package checks, and required packaged-app smoke.",
      "blocksGates": ["G0", "G5", "G7"]
    }
  ]
}
