{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniflow.local/schemas/cat-catch/decision-record.schema.json",
  "title": "Cat Catch approved decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "type",
    "rationale",
    "userImpact",
    "upstreamBehavior",
    "omniflowBehavior",
    "fixtures",
    "fixtureWaiver",
    "approvalRef",
    "approvedAt",
    "revisitWhen"
  ],
  "properties": {
    "$schema": {
      "const": "./decision-record.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "decisionId": {
      "$ref": "#/$defs/identifier"
    },
    "type": {
      "enum": ["platform-adaptation", "upstream-defect-fix", "intentional-exclusion"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "userImpact": {
      "type": "string",
      "minLength": 1
    },
    "upstreamBehavior": {
      "type": "string",
      "minLength": 1
    },
    "omniflowBehavior": {
      "type": "string",
      "minLength": 1
    },
    "fixtures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "fixtureWaiver": {
      "oneOf": [
        {
          "$ref": "#/$defs/fixtureWaiver"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalRef": {
      "$ref": "#/$defs/approvalRef"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "revisitWhen": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "fixtures": {
          "type": "array",
          "minItems": 1
        },
        "fixtureWaiver": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "fixtures": {
          "type": "array",
          "maxItems": 0
        },
        "fixtureWaiver": {
          "$ref": "#/$defs/fixtureWaiver"
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approvalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "payloadHashProfile", "contentHash"],
      "properties": {
        "kind": {
          "enum": ["user-decision", "pull-request-review", "signed-commit"]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "payloadHashProfile": {
          "const": "decision-payload-jcs-v1"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fixtureWaiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "approvalRef"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approvalRef": {
          "$ref": "#/$defs/approvalRef"
        }
      }
    }
  }
}
