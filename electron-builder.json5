// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.loyce.omniflow",
  "asar": true,
  "beforeBuild": "tools/prepare-sqlite3-native.cjs",
  "asarUnpack": [
    "node_modules/@napi-rs/**",
    "node_modules/sqlite3/**",
    "build/native/sqlite3/**"
  ],
  "productName": "Omniflow",
  "executableName": "Omniflow",
  "icon": "build/icons/icon.png",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "dist-plugins",
    "!dist-electron/agent-document-smoke*.mjs",
    "!dist-electron/agent-document-smoke*.cjs",
    {
      "from": "node_modules/@napi-rs",
      "to": "node_modules/@napi-rs",
      "filter": ["canvas/**/*", "canvas-*/**/*"]
    },
    {
      "from": "node_modules/pdfjs-dist",
      "to": "node_modules/pdfjs-dist",
      "filter": ["package.json", "LICENSE", "legacy/build/pdf.mjs", "legacy/build/pdf.worker.mjs", "standard_fonts/**/*", "cmaps/**/*", "wasm/**/*"]
    },
    {
      "from": "node_modules/sqlite3",
      "to": "node_modules/sqlite3",
      "filter": [
        "lib/**/*",
        "package.json"
      ]
    },
    {
      "from": "node_modules/@vscode/tree-sitter-wasm",
      "to": "node_modules/@vscode/tree-sitter-wasm",
      "filter": [
        "LICENSE",
        "package.json",
        "wasm/tree-sitter.js",
        "wasm/tree-sitter.wasm",
        "wasm/tree-sitter-bash.wasm",
        "wasm/tree-sitter-powershell.wasm"
      ]
    },
    {
      "from": "node_modules/bindings",
      "to": "node_modules/bindings"
    },
    {
      "from": "node_modules/file-uri-to-path",
      "to": "node_modules/file-uri-to-path"
    }
  ],
  "mac": {
    "extraResources": [
      {
        "from": "build/native/computer-use/darwin-${arch}",
        "to": "computer-use",
        "filter": ["omniflow-click"]
      }
    ],
    "binaries": ["Contents/Resources/computer-use/omniflow-click"],
    "files": [
      {
        "from": "build/native/sqlite3/darwin-${arch}/build/Release",
        "to": "node_modules/sqlite3/build/Release",
        "filter": [
          "node_sqlite3.node"
        ]
      }
    ],
    "target": [
      "dmg",
      "zip"
    ],
    "extendInfo": {
      "CFBundleName": "Omniflow",
      "CFBundleDisplayName": "Omniflow"
    },
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "files": [
      {
        "from": "build/native/sqlite3/win32-${arch}/build/Release",
        "to": "node_modules/sqlite3/build/Release",
        "filter": [
          "node_sqlite3.node"
        ]
      }
    ],
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "files": [
      {
        "from": "build/native/sqlite3/linux-${arch}/build/Release",
        "to": "node_modules/sqlite3/build/Release",
        "filter": [
          "node_sqlite3.node"
        ]
      }
    ],
    "target": [
      "AppImage"
    ],
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
