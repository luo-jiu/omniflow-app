{
  "formatVersion": 2,
  "id": "example.json-transform",
  "version": "0.1.3",
  "sdkVersion": 1,
  "minHostVersion": "0.2.2",
  "platforms": [
    "darwin"
  ],
  "activation": [
    "tool:example.json-transform.export",
    "workspace:example.json-transform.workspace"
  ],
  "permissions": [
    "resource.read",
    "resource.output.propose",
    "agent.tools"
  ],
  "viewers": [],
  "agentTools": [
    {
      "id": "example.json-transform.export",
      "kind": "file-output",
      "title": "JSON 转换并另存",
      "description": "读取一个 UTF-8 JSON 文件，可选择对象根或数组中对象的顶层字段，并将结果完整输出为新的 JSON 文件。",
      "entry": "tool.html",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "destination"
        ],
        "properties": {
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nodeId"
            ],
            "properties": {
              "nodeId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parentId",
              "fileName"
            ],
            "properties": {
              "parentId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fileName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          },
          "select": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "pretty": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "mediaTypes": [
          "application/json"
        ],
        "maxBytes": 1048576
      },
      "resourceAccess": [
        {
          "parameter": "resource",
          "mode": "read",
          "kind": "file"
        }
      ],
      "timeoutMs": 30000
    }
  ],
  "workspaces": [
    {
      "id": "example.json-transform.workspace",
      "title": "JSON 转换",
      "entry": "workspace.html",
      "commandId": "example.json-transform.run"
    }
  ],
  "commands": [
    {
      "id": "example.json-transform.run",
      "title": "JSON 转换并另存",
      "toolId": "example.json-transform.export",
      "locations": [
        "file-menu",
        "tool-workspace"
      ]
    }
  ]
}
