#EXTM3U
#EXT-X-VERSION:8
#EXT-X-DEFINE:IMPORT="root"
#EXT-X-DEFINE:QUERYPARAM="session"
#EXT-X-DEFINE:NAME="hex-iv",VALUE="0000000000000000000000000000002a"
#EXT-X-DEFINE:NAME="range",VALUE="32@8"
#EXT-X-TARGETDURATION:4
#EXT-X-MEDIA-SEQUENCE:42
#EXT-X-KEY:METHOD=AES-128,URI="{$root}/keys/{$session}.key",IV=0x{$hex-iv}
#EXT-X-MAP:URI="{$root}/init.mp4",BYTERANGE="{$range}"
#EXTINF:4,
{$root}/segments/{$session}-42.m4s
#EXT-X-ENDLIST
