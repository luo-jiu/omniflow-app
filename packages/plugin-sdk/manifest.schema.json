{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "sdkVersion", "minHostVersion", "platforms", "entry", "activation", "permissions", "viewers"],
  "properties": {
    "formatVersion": {"const": 1},
    "id": {"type":"string","maxLength":96,"pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type":"string","pattern":"^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "sdkVersion": {"const":1},
    "minHostVersion": {"type":"string","pattern":"^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "platforms": {"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["darwin","win32","linux"]}},
    "entry": {"type":"string","maxLength":200},
    "activation": {"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","maxLength":160}},
    "permissions": {"type":"array","maxItems":1,"uniqueItems":true,"items":{"enum":["resource.read"]}},
    "viewers": {"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","title","extensions"],"properties":{
      "id":{"type":"string","maxLength":128},"title":{"type":"string","minLength":1,"maxLength":80},
      "extensions":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]{1,32}$"}}
    }}}
  }
}
