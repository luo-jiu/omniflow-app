{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "sdkVersion",
    "minHostVersion",
    "platforms",
    "activation",
    "permissions"
  ],
  "properties": {
    "formatVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "sdkVersion": {
      "const": 1
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin",
          "win32",
          "linux"
        ]
      }
    },
    "entry": {
      "type": "string",
      "maxLength": 200
    },
    "activation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resource.read",
          "directory.read",
          "agent.tools",
          "resource.rename.propose"
        ]
      }
    },
    "viewers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "extensions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "extensions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]{1,32}$"
            }
          },
          "directoryTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMIC"
              ]
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "directoryTypes"
            ],
            "properties": {
              "extensions": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          {
            "not": {
              "required": [
                "directoryTypes"
              ]
            },
            "properties": {
              "extensions": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "agentTools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "entry",
          "inputSchema",
          "outputSchema",
          "resourceAccess",
          "timeoutMs",
          "maxResultBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "entry": {
            "type": "string",
            "maxLength": 200
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "resourceAccess": {
            "type": "array"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "maxResultBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "kind": {
            "const": "rename-proposal"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "resourceAccess": {
                  "const": [
                    {
                      "parameter": "resources",
                      "mode": "metadata",
                      "kind": "file",
                      "maxItems": 50
                    }
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "resourceAccess": {
                  "const": [
                    {
                      "parameter": "resource",
                      "mode": "read",
                      "kind": "file"
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "entry",
          "viewers"
        ],
        "not": {
          "required": [
            "agentTools"
          ]
        },
        "properties": {
          "viewers": {
            "type": "array",
            "minItems": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "resource.read",
                "directory.read"
              ]
            }
          },
          "activation": {
            "type": "array",
            "maxItems": 8
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "viewers"
            ],
            "properties": {
              "viewers": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "agentTools"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "viewers"
        ],
        "properties": {
          "viewers": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "entry"
        ]
      }
    }
  ]
}
