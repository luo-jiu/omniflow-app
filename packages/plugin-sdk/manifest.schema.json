{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "version",
    "sdkVersion",
    "minHostVersion",
    "platforms",
    "activation",
    "permissions"
  ],
  "properties": {
    "formatVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "sdkVersion": {
      "const": 1
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin",
          "win32",
          "linux"
        ]
      }
    },
    "entry": {
      "type": "string",
      "maxLength": 200
    },
    "activation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "resource.read",
          "directory.read",
          "agent.tools",
          "resource.rename.propose",
          "resource.output.propose"
        ]
      }
    },
    "viewers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "extensions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "extensions": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]{1,32}$"
            }
          },
          "directoryTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "COMIC"
              ]
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "directoryTypes"
            ],
            "properties": {
              "extensions": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          {
            "not": {
              "required": [
                "directoryTypes"
              ]
            },
            "properties": {
              "extensions": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        ]
      }
    },
    "agentTools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "entry",
          "inputSchema",
          "resourceAccess",
          "timeoutMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "entry": {
            "type": "string",
            "maxLength": 200
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "resourceAccess": {
            "type": "array"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "maxResultBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "kind": {
            "enum": [
              "rename-proposal",
              "file-output"
            ]
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mediaTypes",
              "maxBytes"
            ],
            "properties": {
              "mediaTypes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "text/csv",
                    "application/json"
                  ]
                }
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "rename-proposal"
                }
              }
            },
            "then": {
              "properties": {
                "resourceAccess": {
                  "const": [
                    {
                      "parameter": "resources",
                      "mode": "metadata",
                      "kind": "file",
                      "maxItems": 50
                    }
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "resourceAccess": {
                  "const": [
                    {
                      "parameter": "resource",
                      "mode": "read",
                      "kind": "file"
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "file-output"
                }
              }
            },
            "then": {
              "required": [
                "output"
              ],
              "properties": {
                "outputSchema": false,
                "maxResultBytes": false
              }
            },
            "else": {
              "required": [
                "outputSchema",
                "maxResultBytes"
              ],
              "properties": {
                "output": false
              }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "toolId",
          "locations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "toolId": {
            "type": "string",
            "maxLength": 128
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "file-menu",
                "tool-workspace"
              ]
            }
          }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "entry",
          "commandId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "entry": {
            "type": "string",
            "maxLength": 200
          },
          "commandId": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "entry",
          "viewers"
        ],
        "not": {
          "required": [
            "agentTools"
          ]
        },
        "properties": {
          "viewers": {
            "type": "array",
            "minItems": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "resource.read",
                "directory.read"
              ]
            }
          },
          "activation": {
            "type": "array",
            "maxItems": 8
          },
          "commands": false,
          "workspaces": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "formatVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "viewers"
            ],
            "properties": {
              "viewers": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "agentTools"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "viewers"
        ],
        "properties": {
          "viewers": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "entry"
        ]
      }
    }
  ]
}
