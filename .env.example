# Frontend API base URL. Tailscale Serve example:
# https://<machine>.<tailnet>.ts.net/api
VITE_API_BASE_URL=http://127.0.0.1:8850/api

# Space- or comma-separated MinIO origins used by CSP.
VITE_STORAGE_ORIGINS="http://localhost:9000 http://127.0.0.1:9000"

# Packaged update feed. Production requires HTTPS; loopback HTTP is allowed for local verification.
VITE_UPDATE_BASE_URL=
