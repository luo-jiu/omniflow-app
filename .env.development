# Development-only API endpoint. Keep local development independent from the cloud deployment.
VITE_API_BASE_URL=http://127.0.0.1:8850/api

# Local macOS MinIO origins used by the development CSP.
VITE_STORAGE_ORIGINS="http://localhost:9000 http://127.0.0.1:9000 http://192.168.1.10:9000"

# Updates are not checked against the production feed from a development build.
VITE_UPDATE_BASE_URL=
