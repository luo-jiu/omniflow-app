{
  "name": "omniflow-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:win": "tsc && vite build && electron-builder --win",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "signing:setup:mac": "bash tools/setup-local-mac-signing.sh",
    "release:mac": "node tools/release-mac.mjs",
    "update:serve": "node tools/serve-update-feed.mjs",
    "preview": "vite preview"
  },
